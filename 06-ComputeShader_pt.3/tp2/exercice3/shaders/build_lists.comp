#version 430 core
layout(local_size_x = 256) in;
struct Particle { vec4 posType; vec4 vel; };
layout(std430, binding = 0) readonly buffer Current { Particle current[]; };
layout(std430, binding = 4) buffer Heads { int cellHead[]; };
layout(std430, binding = 5) buffer Links { int nextParticle[]; };
layout(std430, binding = 6) readonly buffer Box { int boxSize[]; };
uniform uint N;

uint GetCellID(vec3 position, int cells){
    float sizeX = (boxSize[3] - boxSize[0]) / cells;
    float sizeY = (boxSize[4] - boxSize[1]) / cells;
    float sizeZ = (boxSize[5] - boxSize[2]) / cells;
    int ix = clamp(int(position.x - boxSize[0] / sizeX), 0, cells-1);
    int iy = clamp(int(position.y - boxSize[1] / sizeY), 0, cells-1);
    int iz = clamp(int(position.z - boxSize[2] / sizeZ), 0, cells-1);
    int n  = cells;
    return uint(ix + n * (iy + n * iz));
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if(id >= N) return;
    int cell = int(GetCellID(current[id].posType.xyz, 32));

    int temp = atomicExchange(cellHead[cell], int(id));
    nextParticle[id] = temp;
}