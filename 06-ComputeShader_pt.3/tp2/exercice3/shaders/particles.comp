#version 430 core
layout(local_size_x = 256) in;
struct Particle { vec4 posType; vec4 vel; };
layout(std430, binding = 0) readonly buffer Current { Particle current[]; };
layout(std430, binding = 1) writeonly buffer Next { Particle next[]; };
layout(std430, binding = 6) readonly buffer Box { float boxSize[]; };

uniform uint N;

void main() {
  uint id = gl_GlobalInvocationID.x;
  if (id >= N) return;
  
  next[id].posType.xyz = current[id].posType.xyz + current[id].vel.xyz;
  if(current[id].posType.x < -boxSize[0] || current[id].posType.x > boxSize[3]){
    next[id].vel.x = current[id].vel.x * -1;
    next[id].posType.x = max(-boxSize[0], min(current[id].posType.x, boxSize[3]));
  }
  if(current[id].posType.y < -boxSize[1] || current[id].posType.y > boxSize[4]) {
    next[id].vel.y = current[id].vel.y * -1;
    next[id].posType.y = max(-boxSize[1], min(current[id].posType.y, boxSize[4]));
  }
  if(current[id].posType.z < -boxSize[2] || current[id].posType.z > boxSize[5]){
    next[id].vel.z = current[id].vel.z * -1;
    next[id].posType.z = max(-boxSize[2], min(current[id].posType.z, boxSize[5]));
  }
}
