#version 430 core
layout(local_size_x = 256) in;
struct Particle { vec4 posType; vec4 vel; };
layout(std430, binding = 0) readonly buffer Current { Particle current[]; };
layout(std430, binding = 1) writeonly buffer Next { Particle next[]; };
layout(std430, binding = 4) readonly buffer Heads { int cellHead[]; };
layout(std430, binding = 5) readonly buffer Links { int nextParticle[]; };

uniform uint N;

ivec3 GetCellFromPosition(vec3 position, float size, int cells)
{
  int ix = clamp(int(position.x / size), 0, cells-1);
  int iy = clamp(int(position.y / size), 0, cells-1);
  int iz = clamp(int(position.z / size), 0, cells-1);
  return ivec3(ix, iy, iz);
}

uint GetCellID(ivec3 position, int cells)
{
  return uint(position.x + cells * (position.y + cells * position.z));
}

void main() {
  uint id = gl_GlobalInvocationID.x;
  if (id >= N) return;
  
  next[id] = current[id];
  
  vec4 otherSeparation = vec4(0);
  vec4 otherAlignement = vec4(0);
  vec4 otherCohesion = vec4(0);
  int count = 0;
  
  ivec3 cellPos = GetCellFromPosition(current[id].posType.xyz, 2, 32);
  uint cell = GetCellID(cellPos, 32);

  for(int i = -1; i <= 1; i++)
  {
    for(int j = -1; j <= 1; j++)
    {
      for(int k = -1; k <= 1; k++)
      {
        ivec3 newCellPos = cellPos + ivec3(i,j,k);
        if(cellPos.x < 0 || newCellPos.x >= 32) continue;
        if(cellPos.y < 0 || newCellPos.y >= 32) continue;
        if(cellPos.z < 0 || newCellPos.z >= 32) continue;
        
        uint checkCell = GetCellID(newCellPos, 32);
        if(cellHead[checkCell] == -1) continue;
        
        uint followingCell = cellHead[checkCell];
        vec3 distance = current[cellHead[checkCell]].posType.xyz - current[cellHead[checkCell]].posType.xyz;
        float distanceSqrt = (distance.x * distance.x) + (distance.y * distance.y) + (distance.z * distance.z);
        
        int n = 0;
        while(true && n < N)
        {
          count ++;
          n++;
          distance = current[followingCell].posType.xyz - current[id].posType.xyz;
          distanceSqrt = (distance.x * distance.x) + (distance.y * distance.y) + (distance.z * distance.z);
          otherSeparation += vec4((pow((2*3) / 2, 2) - distanceSqrt) * distance, 0);
          otherCohesion += current[followingCell].posType;
          otherAlignement += current[followingCell].vel;
          followingCell = nextParticle[followingCell];
          if(followingCell == -1) break;
        }
      }
    }
  }

  if(count != 0)
  {
    otherCohesion /= float(count);
    if(dot(otherSeparation, otherSeparation) > 1e-12)otherCohesion = normalize(otherCohesion - current[id].posType) * 0.7f;
    if(dot(otherSeparation, otherSeparation) > 1e-12) otherSeparation = normalize(otherSeparation) * 0.6f;
    if(dot(otherAlignement, otherAlignement) > 1e-12) otherAlignement = normalize(otherAlignement) * 0.8f;
  }
  next[id].vel = normalize(current[id].vel + otherCohesion + otherSeparation + otherAlignement);
}

