#version 430 core
layout(local_size_x = 256) in;
struct Particle { vec4 posType; vec4 vel; };
layout(std430, binding = 0) readonly buffer Current { Particle current[]; };
layout(std430, binding = 1) writeonly buffer Next { Particle next[]; };

uniform uint N;
uniform float boxSize;

void main() {
  uint id = gl_GlobalInvocationID.x;
  if (id >= N) return;
  
  next[id].posType.xyz = current[id].posType.xyz + current[id].vel.xyz;
  if(current[id].posType.x < 0 || current[id].posType.x > boxSize){
    next[id].vel.x = current[id].vel.x * -1;
    next[id].posType.x = max(0, min(current[id].posType.x, boxSize));
  }
  if(current[id].posType.y < 0 || current[id].posType.y > boxSize) {
    next[id].vel.y = current[id].vel.y * -1;
    next[id].posType.y = max(0, min(current[id].posType.y, boxSize));
  }
  if(current[id].posType.z < 0 || current[id].posType.z > boxSize){
    next[id].vel.z = current[id].vel.z * -1;
    next[id].posType.z = max(0, min(current[id].posType.z, boxSize));
  }
}
