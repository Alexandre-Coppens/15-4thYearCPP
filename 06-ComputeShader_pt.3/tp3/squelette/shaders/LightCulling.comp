#version 430 core
layout(local_size_x = 256) in;
struct PointLight { float positionRadius[4]; float colorIntensity[4]; };
layout(std430, binding = 0) readonly buffer Lights { PointLight lights[]; };
layout(std430, binding = 1) buffer Valid { uint isValid[]; };
layout(std430, binding = 2) readonly buffer Frustrum { vec4 planes[]; };

uniform uint n;

bool IsLightInView(uint _id, uint _normal)
{
    vec3 lightPos = vec3(lights[_id].positionRadius[0], lights[_id].positionRadius[1], lights[_id].positionRadius[2]);
    return (dot(planes[_normal].xyz, lightPos) + planes[_normal].w >= -lights[_id].positionRadius[3]);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if(id >= n) return;

    bool validation = true;
    if(!IsLightInView(id, 0)) validation = false;
    if(!IsLightInView(id, 1)) validation = false;
    if(!IsLightInView(id, 2)) validation = false;
    if(!IsLightInView(id, 3)) validation = false;
    if(!IsLightInView(id, 4)) validation = false;
    if(!IsLightInView(id, 5)) validation = false;
    uint add = validation ? 1: 0;
    isValid[id + 1] = add;
    atomicAdd(isValid[0], add);
}