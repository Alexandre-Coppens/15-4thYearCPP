#version 430 core

layout(local_size_x = 1024) in;
layout(std430, binding = 0) buffer Vector { float values[]; };

uniform uint size;

void main() {
    uint id = gl_GlobalInvocationID.x;
    
    uint currentSize = size;
    for(uint n = 1; n < size; n *= 2)
    {
        uint loopNeededForRow = uint(ceil(currentSize / 1024.f));
        for(uint i = 0; i < loopNeededForRow; i++)
        {
            uint startId = (1024 * i * n) + id * n;
            if(startId % (2*n) == 0 && (startId + n) < size)
            {
                values[startId] += values[startId + n];
                values[startId + n] = 0;
            }
        }
        barrier();
        currentSize = currentSize >> 1;
    }
}
